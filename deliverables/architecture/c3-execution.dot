digraph "c3-execution" {
graph [fontname="Segoe UI", bgcolor="#ffffff", pad="0.35", nodesep="0.4", ranksep="0.65", splines=polyline, labelloc="t", fontsize=22, fontcolor="#172435"];
node [fontname="Segoe UI", shape=box, style="rounded,filled", fillcolor="#e9f0ff", color="#7696ce", fontcolor="#18385f", penwidth=1.2, fontsize=12, margin="0.2,0.16"];
edge [fontname="Segoe UI", fontsize=10, fontcolor="#52647b", color="#9aacc2", arrowsize=0.65, penwidth=1.1];
rankdir=LR;
label="C4 L3 · Компоненты Workflow worker";
subgraph cluster_worker {label="Workflow worker · Python";style="rounded,dashed";color="#8aa7d0";fontcolor="#566b86";fontsize=15;
rw [label="ResearchWorkflow\n[Component]\nTemporal workflow\nРазбор → план → ожидание"];
runw [label="RunWorkflow\n[Component]\nTemporal workflow\nЗапуск → сбор → оценка"];
ingest [label="IngestActivity\n[Component]\nFetcher / parsers\nSnapshot, dedup, primary sources"];
planning [label="PlanningActivity\n[Component]\nResearcher session adapter\nГипотезы, package, draft plan"];
tool [label="ToolBroker\n[Component]\nScoped function tools\nПроверка каждой операции агента"];
dispatch [label="DispatchActivity\n[Component]\nRunner adapter\nУтверждённый manifest / job"];
analysis [label="AnalyzeActivity\n[Component]\nMeasurement adapter\nScoring / facts / report checks"];
}
api [label="Control API\n[External Container]\nPolicy, approvals, run registry", fillcolor="#f0f2f5", color="#aab3c0", fontcolor="#475364"];
rt [label="Agent runtime\n[External Container]\nResearcher / coding agent", fillcolor="#f0f2f5", color="#aab3c0", fontcolor="#475364"];
runner [label="Runner coordinator\n[External Container]\nSandbox job lifecycle", fillcolor="#f0f2f5", color="#aab3c0", fontcolor="#475364"];
measure [label="Measurement worker\n[External Container]\nObserved data → metrics", fillcolor="#f0f2f5", color="#aab3c0", fontcolor="#475364"];
rw -> ingest [label="Activity: snapshot refs"];
rw -> planning [label="Activity: research context"];
planning -> rt [label="RPC: start / resume"];
rt -> tool [label="Scoped proposed action"];
tool -> api [label="Validated domain command"];
rw -> api [label="Plan draft / wait on approval"];
rw -> runw [label="Start approved child run"];
runw -> dispatch [label="Activity: immutable manifest"];
dispatch -> runner [label="submit / poll / cancel"];
runw -> analysis [label="Activity: artifact refs"];
analysis -> measure [label="score / aggregate / verify"];
runw -> api [label="Run projection / events"];

}
